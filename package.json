{
  "name": "stemp-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "digitize:library": "node scripts/digitize-library.mjs",
    "digitize:resources": "node scripts/digitize-resources.mjs",
    "digitize:all": "run-s digitize:library digitize:resources",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "1.27.0",
    "@vueuse/core": "14.3.0",
    "axios": "1.18.1",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^5.6.205",
    "pinia": "4.0.2",
    "qrcode": "^1.5.4",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node20": "20.1.9",
    "@types/node": "26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.8"
  }
}
